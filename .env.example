# database
DATABASE_URL=postgres://kaoming:changeme@localhost:5432/kaoming
DB_PASSWORD=changeme

# auth
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
CRM_DOMAIN=localhost

# locale and time
DEFAULT_LOCALE=en
TZ=Asia/Taipei

# translation provider for after-sales cases only.
# Never used for factory documents — see docs/10-aftersales-cases.md
TRANSLATION_API_KEY=

# initial administrator for db:bootstrap-admin; provide temporarily on office installs
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
