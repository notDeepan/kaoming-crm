# Copy to .env and adjust. Never commit the real .env.

# SQLite for local evaluation. Swap to a postgresql:// URL to deploy — the schema is unchanged.
DATABASE_URL="file:./dev.db"

# Session cookie encryption. Must be 32+ characters. Generate a fresh one per deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Document storage root — must be outside the web root (spec DM-01 / SE-12).
STORAGE_ROOT="./storage"
